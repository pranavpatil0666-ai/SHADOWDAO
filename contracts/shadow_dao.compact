// PUBLIC DATA:
// - proposals: Map of proposal_id -> { title, description, yes, no, abstain }.
//   The tally (yes/no/abstain) is PUBLIC so results are readable on-chain.
// - nullifiers: Set of used vote nullifiers, prevents double voting.
//
// PRIVATE DATA (Witness):
// - member_secret: a secret known only to the voter. It never appears on-chain;
//   only a nullifier derived from it is stored, so the voter stays anonymous
//   while the choice they cast is disclosed to update the public tally.

pragma language_version >= 0.14.0;
import CompactStandardLibrary;

export struct Proposal {
    title: Opaque<"string">;
    description: Opaque<"string">;
    yes: Uint<32>;
    no: Uint<32>;
    abstain: Uint<32>;
}

export struct VoteNullifier {
    proposalId: Uint<32>;
    voterSecret: Bytes<32>;
}

export ledger proposals: Map<Uint<32>, Proposal>;
export ledger nullifiers: Set<Bytes<32>>;

export circuit create_proposal(
  proposal_id: Uint<32>,
  title: Opaque<"string">,
  description: Opaque<"string">,
): [] {
    const pubId = disclose(proposal_id);
    const pubTitle = disclose(title);
    const pubDesc = disclose(description);
    assert(!proposals.member(pubId), "proposal already exists");
    proposals.insert(pubId, Proposal {
        title: pubTitle,
        description: pubDesc,
        yes: 0 as Uint<32>,
        no: 0 as Uint<32>,
        abstain: 0 as Uint<32>,
    });
}

export circuit vote(
  proposal_id: Uint<32>,
  choice: Uint<32>,
  member_secret: Bytes<32>,
): Bytes<32> {
    const pubId = disclose(proposal_id);
    const pubChoice = disclose(choice);

    assert(pubChoice == 0 as Uint<32> || pubChoice == 1 as Uint<32> || pubChoice == 2 as Uint<32>, "invalid choice");
    assert(proposals.member(pubId), "proposal does not exist");

    const nul = persistentHash<VoteNullifier>(VoteNullifier {
        proposalId: pubId,
        voterSecret: member_secret,
    });
    const pubNul = disclose(nul);

    assert(!nullifiers.member(pubNul), "already voted on this proposal");
    nullifiers.insert(pubNul);

    const p = proposals.lookup(pubId);
    const isYes = disclose(pubChoice == 0 as Uint<32>);
    const isNo = disclose(pubChoice == 1 as Uint<32>);
    const isAbstain = disclose(pubChoice == 2 as Uint<32>);
    proposals.insert(pubId, Proposal {
        title: p.title,
        description: p.description,
        yes: isYes ? (p.yes + 1) as Uint<32> : p.yes,
        no: isNo ? (p.no + 1) as Uint<32> : p.no,
        abstain: isAbstain ? (p.abstain + 1) as Uint<32> : p.abstain,
    });

    return nul;
}
